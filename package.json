{
  "name": "radar-price",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent deal monitoring and arbitrage engine for Facebook Marketplace",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @radar/worker test",
    "dev:worker": "pnpm --filter @radar/worker dev",
    "dev:login": "pnpm --filter @radar/worker login",
    "dev:api": "pnpm --filter @radar/api dev",
    "dev:web": "pnpm --filter @radar/web dev",
    "prisma:generate": "pnpm --filter @radar/database prisma:generate",
    "prisma:migrate": "pnpm --filter @radar/database prisma:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
